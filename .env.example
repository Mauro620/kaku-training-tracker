# ---------- Aplicación ----------
APP_NAME=rendimiento-api
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
TZ=America/Bogota

# ---------- Base de datos ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rendimiento
POSTGRES_USER=rendimiento
POSTGRES_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------- Servidor ----------
# Puerto donde uvicorn expone el API dentro del contenedor.
# Lo usa docker-compose para mapear host:container.
API_PORT=8000

# ---------- Seguridad ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=90
CORS_ORIGINS=http://localhost:3000

# ---------- Usuario único (seed) ----------
SEED_USUARIO_NOMBRE=
SEED_USUARIO_EMAIL=
SEED_USUARIO_PASSWORD=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Rendimiento

# ---------- Integraciones (fase 9) ----------
NOTION_API_KEY=
NOTION_REGISTRO_DIARIO_DATA_SOURCE_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
