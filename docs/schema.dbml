enum demanda {
	alta
	media
	baja
}

enum fase_ciclo {
	readaptacion
	carga
	descarga
}

enum estado_ciclo {
	planificado
	activo
	cerrado
}

enum estado_sesion_plan {
	pendiente
	cumplido
	movido
	descartado
}

enum carga_lumbar {
	alta
	media
	baja
}

enum tipo_medicion {
	carga
	distancia
	tiempo
	tecnica
}

enum origen_dato {
	manual
	health_kit
	notion_backfill
}

Table usuario [headercolor: #175e7a] {
	id uuid [ pk ]
	nombre varchar(80) [ not null ]
	peso_objetivo_kg numeric(5,2)
	agua_objetivo_ml_min integer
	agua_objetivo_ml_max integer
	creado_en timestamptz [ not null, default: `now()` ]

	Note: 'App de un solo usuario hoy. La FK existe para no migrar 20 tablas si mañana entra un compañero o un preparador. Los umbrales calibrables (objetivo de sueño) NO viven aquí: viven en parametro, que es el unico lugar calibrable. agua_objetivo_ml_* SÍ vive acá, no en parametro: es una meta personal directa (como peso_objetivo_kg), no una constante de fórmula compartida.'
}

Table perfil_atleta [headercolor: #175e7a] {
	usuario_id uuid [ pk ]
	posicion varchar(60) [ not null ]
	rol_tactico text [ not null ]
	pie_dominante varchar(60) [ not null ]
	talla_cm numeric(4,1)
	peso_kg numeric(5,2)
	lesiones_activas jsonb [ not null, default: `'[]'` ]
	objetivos jsonb [ not null, default: `'[]'` ]
	eventos_fijos jsonb [ not null, default: `'[]'` ]
	ventanas jsonb [ not null, default: `'[]'` ]
	lugares jsonb [ not null, default: `'[]'` ]
	equipamiento_propio jsonb [ not null, default: `'[]'` ]
	actualizado_en timestamptz [ not null, default: `now()` ]

	Note: 'Un registro por usuario (PK = FK). Las listas son JSONB porque se leen y escriben siempre completas y el export para el LLM es el mismo JSON. Formas: lesiones_activas [texto]; objetivos [texto] en orden de prioridad; eventos_fijos [{dia 0-6, hora HH:MM, tipo_sesion (codigo de tipo_sesion), nombre, duracion_min?}]; ventanas [{dia 0-6, inicio HH:MM, fin HH:MM, lugares [nombre de lugar]}]; lugares [{nombre, equipamiento [texto]}]; equipamiento_propio [texto] (lo que el atleta lleva consigo, disponible en cualquier ventana). peso_kg es el peso DECLARADO, independiente de medida_corporal (peso medido).'
}

Table tipo_sesion [headercolor: #175e7a] {
	id smallint [ pk, increment ]
	codigo varchar(30) [ not null, unique ]
	nombre varchar(60) [ not null ]
	demanda demanda [ not null ]

	Note: 'fuerza, velocidad_salto, resistencia, balon_control, balon_distribucion, recuperacion, partido, activacion. activacion es demanda BAJA deliberadamente: un priming no cuenta como dia de alta demanda en la ventana previa a un partido.'
}

Table ejercicio [headercolor: #175e7a] {
	id integer [ pk, increment ]
	nombre varchar(80) [ not null, unique ]
	patron varchar(40)
	carga_lumbar carga_lumbar [ not null, default: `baja` ]
	tipo_sesion_id smallint
	tipo_medicion tipo_medicion [ not null ]
	descripcion text
	activo boolean [ not null, default: true ]

	Note: 'carga_lumbar permite filtrar alternativas seguras cuando la molestia lumbar está activa. tipo_medicion determina que campos acepta cada bloque de este ejercicio (REGLAS_NEGOCIO §15): carga→series/reps/peso_kg, distancia→reps/distancia_m, tiempo→series opcional/duracion_s, tecnica→reps o duracion_s + calidad. tipo_sesion_id es NULLABLE a proposito (migracion a09181f1ca0e): unico catalogo con creacion de usuario (POST /catalogos/ejercicios), el usuario que crea inline no elige tipo de sesion. descripcion es PERMANENTE —qué es y cómo se ejecuta— y NO confundir con bloque.nota, que es DE ESTA VEZ (REGLAS_NEGOCIO §15): mezclarlas llena el catalogo de duplicados disfrazados. activo (migracion f1a2b3c4d5e6) filtra el selector: la fusion de duplicados lo baja a false sin borrar la fila, conservando bloque.ejercicio_id de los registros historicos.'
}

Table zona_corporal [headercolor: #53177a] {
	id smallint [ pk, increment ]
	nombre varchar(40) [ not null, unique ]
}

Table tipo_test [headercolor: #175e7a] {
	id smallint [ pk, increment ]
	codigo varchar(30) [ not null, unique ]
	nombre varchar(60) [ not null ]
	unidad varchar(10) [ not null ]
	mejor_es_mayor boolean [ not null ]

	Note: 'mejor_es_mayor evita el bug clásico: en sprint_10m menos es mejor, en cmj más es mejor. Sin este campo, el cálculo de mejora se invierte en la mitad de los tests.'
}

Table habito [headercolor: #34eb7a] {
	id integer [ pk, increment ]
	usuario_id uuid [ not null ]
	nombre varchar(60) [ not null ]
	activo boolean [ not null, default: true ]
	orden smallint [ not null, default: 0 ]

	indexes {
		(usuario_id, nombre) [ unique ]
	}

	Note: 'Tabla, no columnas. Agregar un hábito es un INSERT, no una migración.'
}

Table ciclo [headercolor: #175e7a] {
	id integer [ pk, increment ]
	usuario_id uuid [ not null ]
	numero smallint [ not null ]
	objetivo text [ not null ]
	fecha_inicio date [ not null ]
	semanas smallint [ not null, default: 4 ]
	estado estado_ciclo [ not null, default: `planificado` ]
	fecha_fin_prevista date [ not null ]
	fecha_cierre_real date

	indexes {
		(usuario_id, numero) [ unique ]
	}

	Note: 'fecha_fin_prevista = fecha_inicio + (semanas×7 − 1) días, columna GENERATED (Postgres calcula, nunca se captura). fecha_cierre_real es NULL hasta que el ciclo se cierra; CHECK fecha_cierre_real IS NULL OR estado = cerrado — evita un ciclo cerrado sin fecha o una fecha en un ciclo que sigue activo. La distancia entre fecha_fin_prevista y fecha_cierre_real es la señal de "se cortó antes/después de lo planeado" que Fase 8 necesita para no comparar ciclos completos contra interrumpidos como si fueran iguales.'
}

Table ciclo_semana [headercolor: #175e7a] {
	id integer [ pk, increment ]
	ciclo_id integer [ not null ]
	numero smallint [ not null ]
	fase fase_ciclo [ not null ]
	rpe_objetivo_min smallint
	rpe_objetivo_max smallint
	volumen_pct smallint [ not null, default: 100 ]

	indexes {
		(ciclo_id, numero) [ unique ]
	}
}

Table ciclo_semana_composicion [headercolor: #175e7a] {
	id integer [ pk, increment ]
	ciclo_semana_id integer [ not null ]
	tipo_sesion_id smallint [ not null ]
	cantidad_objetivo smallint [ not null ]

	indexes {
		(ciclo_semana_id, tipo_sesion_id) [ unique ]
	}

	Note: 'Composición objetivo de la semana por tipo de sesión (ej. fuerza: 2, resistencia: 1). Cuelga de ciclo_semana, no de ciclo: la semana de descarga puede llevar 1 de fuerza en vez de 2 sin lógica especial, cada semana declara la suya. Cumplimiento = contar sesion reales de ese tipo dentro del rango de fechas de la semana (derivado de ciclo.fecha_inicio + numero, no una columna nueva) contra cantidad_objetivo. CHECK cantidad_objetivo > 0.'
}

Table sesion_plan [headercolor: #175e7a] {
	id integer [ pk, increment ]
	usuario_id uuid [ not null ]
	ciclo_semana_id integer
	fecha_prevista date
	dia_sugerido smallint
	tipo_sesion_id smallint [ not null ]
	objetivo text
	duracion_min_est smallint
	rpe_objetivo smallint
	estado estado_sesion_plan [ not null, default: `pendiente` ]
	clave_import varchar(80)
	nombre varchar(60)
	nota text

	indexes {
		(ciclo_semana_id, clave_import) [ unique, note: 'PARCIAL: WHERE clave_import IS NOT NULL' ]
	}

	Note: 'El plan se registra ANTES. El delta contra la sesión real es la señal de fatiga. fecha_prevista es NULLABLE desde que el cumplimiento pasó a medirse por composición semanal, no por fecha exacta (REGLAS_NEGOCIO §13): un plan puede vivir solo dentro de una ciclo_semana sin comprometerse a un día. dia_sugerido (0=lunes..6=domingo) es sugerencia de UI, no obligación — CHECK dia_sugerido IS NULL OR dia_sugerido BETWEEN 0 AND 6. estado se PERSISTE, no se deriva: descartado lo declara el usuario y cumplido/movido los escribe resolver_estado_de_plan() cada vez que una sesion se crea, cambia de fecha o se borra. movido = existe una sesion contra este plan pero su fecha cae en un dia distinto al dia_sugerido; sigue contando para el cumplimiento semanal. clave_import es {dia_sugerido}-{tipo_sesion.codigo} y solo la asigna el importador de plan semanal (docs/PLAN_IMPORT.md): su indice unico es PARCIAL para que los planes creados a mano (clave NULL) no choquen entre si. Un plan en cumplido o movido NUNCA se reemplaza al reimportar. nombre es la etiqueta legible ("Priming pre-partido"): el tipo sigue siendo el catalogo cerrado que alimenta demanda/espaciado/semáforo, lo descriptivo va aca. nota es el contexto de esta semana: a diferencia de ejercicio.descripcion (se crea una vez con el ejercicio), nombre y nota cambian semana a semana y se reemplazan al reimportar.'
}

Table bloque_plan [headercolor: #175e7a] {
	id integer [ pk, increment ]
	sesion_plan_id integer [ not null ]
	ejercicio_id integer [ not null ]
	orden smallint [ not null ]
	series smallint
	reps_min smallint
	reps_max smallint
	peso_objetivo_kg numeric(5,2)
	distancia_objetivo_m numeric(5,1)
	duracion_objetivo_s integer
	nota varchar(120)

	indexes {
		(sesion_plan_id, orden) [ unique ]
	}

	Note: 'Objetivo del bloque real (REGLAS_NEGOCIO §15). series/reps_min/reps_max quedaron nullable desde que existen distancia_objetivo_m y duracion_objetivo_s: cual aplica lo determina ejercicio.tipo_medicion. Sin calidad_objetivo a proposito: la calidad es una medida de ejecucion real, no algo que se planifique de antemano. nota es DE ESTA VEZ ("al 60-70%", "con la zurda") y se precarga hacia bloque.nota al registrar; NO confundir con ejercicio.descripcion, que es PERMANENTE (REGLAS_NEGOCIO §15).'
}

Table sesion [headercolor: #175e7a] {
	id uuid [ pk ]
	usuario_id uuid [ not null ]
	sesion_plan_id integer [ unique ]
	fecha date [ not null ]
	tipo_sesion_id smallint [ not null ]
	duracion_min smallint [ not null, note: 'CHECK > 0' ]
	rpe smallint [ not null, note: 'CHECK entre 1 y 10' ]
	nota text
	idempotency_key uuid [ not null, unique ]
	registrado_en timestamptz [ not null, default: `now()` ]

	indexes {
		(usuario_id, fecha)
	}

	Note: 'carga_srpe = rpe * duracion_min → columna GENERATED ALWAYS AS (rpe * duracion_min) STORED. Nunca se captura. idempotency_key hace la cola de sync offline segura ante reintentos.'
}

Table bloque [headercolor: #175e7a] {
	id bigint [ pk, increment ]
	sesion_id uuid [ not null ]
	ejercicio_id integer [ not null ]
	orden smallint [ not null ]
	series smallint
	reps smallint
	distancia_m numeric(5,1)
	duracion_s integer
	calidad smallint [ note: 'Nullable, pero si viene: CHECK entre 1 y 5' ]
	peso_kg numeric(5,2)
	rpe smallint [ note: 'Nullable, pero si viene: CHECK entre 1 y 10' ]
	dolor_lumbar boolean [ not null, default: false ]
	nota varchar(120)

	indexes {
		(sesion_id, orden) [ unique ]
	}

	Note: 'Antes se llamaba serie: mide "N series x M reps", pero un bloque de tecnica o distancia no tiene series ni reps en ese sentido (REGLAS_NEGOCIO §15). series/reps son nullable: cuales de los 5 campos de medicion aplican los determina ejercicio.tipo_medicion, validado en el service (no hay CHECK cruzando a otra tabla).'
}

Table partido [headercolor: #175e7a] {
	id uuid [ pk ]
	sesion_id uuid [ not null, unique ]
	rival varchar(80)
	formato varchar(20)
	minutos_jugados smallint [ not null ]
	goles smallint [ not null, default: 0 ]
	asistencias smallint [ not null, default: 0 ]
	recuperaciones smallint
	salio_bien text
	a_ajustar text

	Note: 'Un partido ES una sesión: duración y RPE viven en sesion, no se duplican. minutos_jugados ≠ sesion.duracion_min (esta incluye calentamiento).'
}

Table registro_sueno [headercolor: #53177a] {
	id bigint [ pk, increment ]
	usuario_id uuid [ not null ]
	fecha date [ not null ]
	inicio timestamptz [ not null ]
	fin timestamptz [ not null, note: 'CHECK fin > inicio' ]
	celular_fuera boolean [ note: 'Unico lugar donde vive este dato. NO existe como habito: se llena en el mismo formulario de sueno.' ]
	origen origen_dato [ not null, default: `manual` ]
	idempotency_key uuid [ unique ]

	indexes {
		(usuario_id, fecha) [ unique ]
	}

	Note: 'timestamptz en vez de time: cruzar medianoche con dos campos time obliga a lógica condicional en cada consulta. horas_sueno = EXTRACT(EPOCH FROM fin - inicio)/3600, generada. La fecha es la del despertar. INVARIANTE DE SERVICIO: fecha debe coincidir con la fecha local de fin. No se puede imponer con CHECK ni con columna generada porque la conversion de zona horaria no es IMMUTABLE en Postgres. idempotency_key es nullable para admitir backfill historico (Fase 9) sin UUID; la deduplicacion la hace la PK (usuario_id, fecha), el key lo genera la cola de Fase 5 para distinguir reintentos de requests distintas.'
}

Table registro_bienestar [headercolor: #53177a] {
	id bigint [ pk, increment ]
	usuario_id uuid [ not null ]
	fecha date [ not null ]
	sueno_pobre smallint [ not null ]
	fatiga smallint [ not null ]
	dolor_muscular smallint [ not null ]
	estres smallint [ not null ]
	idempotency_key uuid [ unique ]

	indexes {
		(usuario_id, fecha) [ unique ]
	}

	Note: 'Cuatro ítems 1-5. hooper = suma de los cuatro, columna generada. CHECK entre 1 y 5 en cada uno. Direccion: 1 es bueno, 5 es malo en los cuatro. El campo se llama sueno_pobre y no sueno_calidad para que el nombre apunte en la misma direccion que el valor. idempotency_key nullable (ver registro_sueno).'
}

Table registro_hidratacion [headercolor: #53177a] {
	id bigint [ pk, increment ]
	usuario_id uuid [ not null ]
	fecha date [ not null ]
	ml_totales integer [ not null, default: 0 ]
	idempotency_key uuid [ unique ]

	indexes {
		(usuario_id, fecha) [ unique ]
	}

	Note: 'A diferencia de registro_sueno/registro_bienestar, cada registro SUMA a ml_totales en vez de reemplazarlo (un termo de 750ml es un tap, no la cantidad total del día). CHECK ml_totales >= 0. idempotency_key nullable (ver registro_sueno).'
}

Table habito_registro [headercolor: #34eb7a] {
	habito_id integer [ not null ]
	fecha date [ not null ]
	valor boolean [ not null ]
	idempotency_key uuid [ unique ]

	indexes {
		(habito_id, fecha) [ pk ]
	}

	Note: 'PK compuesta (habito_id, fecha): un habito tiene como maximo un registro por dia. Esa PK es la deduplicacion natural de la fila. idempotency_key (nullable) lo agrega la cola de Fase 5 para distinguir reintentos del mismo POST de dos requests distintas con la misma PK (ej. el usuario cambia el valor del habito en la misma fecha). Nullable para backfill historico (Fase 9).'
}

Table molestia [headercolor: #53177a] {
	id bigint [ pk, increment ]
	usuario_id uuid [ not null ]
	fecha date [ not null ]
	zona_id smallint [ not null ]
	intensidad smallint [ not null, note: 'CHECK entre 1 y 10. El 0 es imposible por definicion: sin molestia no hay fila.' ]
	nota text
	idempotency_key uuid [ unique ]

	indexes {
		(usuario_id, fecha, zona_id) [ unique ]
		(usuario_id, zona_id, fecha)
	}

	Note: 'Sin molestia no hay fila. No se pregunta a diario. El segundo índice sirve la consulta de frecuencia por zona en 14 días. idempotency_key nullable (ver registro_sueno).'
}

Table medida_corporal [headercolor: #53177a] {
	id bigint [ pk, increment ]
	usuario_id uuid [ not null ]
	fecha date [ not null ]
	peso_kg numeric(5,2) [ not null ]
	fc_reposo smallint
	cintura_cm numeric(4,1)
	origen origen_dato [ not null, default: `manual` ]

	indexes {
		(usuario_id, fecha) [ unique ]
	}

	Note: 'Semanal, en ayunas, misma hora. El ruido diario es agua. cintura_cm es opcional (perimetro de cintura). origen distingue el dato manual del importado de Health. La unicidad (usuario_id, fecha) es la deduplicacion natural de la cola de sync.'
}

Table auth_usuario [headercolor: #8b3a3a] {
	usuario_id uuid [ pk ]
	email varchar(120) [ not null, unique ]
	password_hash varchar(255) [ not null ]
	refresh_token_hash varchar(255)
	refresh_token_expira_en timestamptz
	password_changed_at timestamptz [ not null, default: `now()` ]
	ultimo_acceso_en timestamptz
	creado_en timestamptz [ not null, default: `now()` ]

	Note: 'Tabla separada de usuario para que la identidad de login (email, password, refresh) no contamine la tabla de dominio. PK = usuario_id porque la relacion es 1:1: un usuario, una sola fila de auth. refresh_token_hash se rota a NULL en logout; NULL equivale a "sin sesion activa". password_hash usa argon2id; refresh_token_hash usa SHA-256 porque el refresh es de alta entropia (48 bytes random), no es debil como una contrasena humana.'
}

Table test_fisico [headercolor: #175e7a] {
	id uuid [ pk ]
	usuario_id uuid [ not null ]
	fecha date [ not null ]
	tipo_test_id smallint [ not null ]
	superficie varchar(40)
	condiciones text
	idempotency_key uuid [ not null, unique ]

	indexes {
		(usuario_id, tipo_test_id, fecha)
	}

	Note: 'superficie y condiciones no son decorativos: comparar un sprint en pista contra uno en grama es comparar cosas distintas. El indice (usuario_id, tipo_test_id, fecha) NO es unico a proposito (se puede repetir un test el mismo dia), por eso hace falta idempotency_key para la cola de sync.'
}

Table test_intento [headercolor: #175e7a] {
	id bigint [ pk, increment ]
	test_fisico_id uuid [ not null ]
	numero smallint [ not null ]
	valor numeric(7,3) [ not null ]

	indexes {
		(test_fisico_id, numero) [ unique ]
	}

	Note: 'Un modelo para todos los tests: RSA son 6 intentos, CMJ es mejor de 3, Yo-Yo es 1. Mejor, media y %decremento se calculan en el mart, no se almacenan. En Yo-Yo IR1 se almacena SOLO la distancia en valor; el nivel se deriva de la distancia con la tabla del protocolo, no se captura.'
}

Ref fk_ejercicio_tipo_sesion_id_tipo_sesion {
	ejercicio.tipo_sesion_id > tipo_sesion.id [ delete: no action, update: no action ]
}

Ref fk_habito_usuario_id_usuario {
	habito.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_ciclo_usuario_id_usuario {
	ciclo.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_ciclo_semana_ciclo_id_ciclo {
	ciclo_semana.ciclo_id > ciclo.id [ delete: no action, update: no action ]
}

Ref fk_ciclo_semana_composicion_ciclo_semana_id_ciclo_semana {
	ciclo_semana_composicion.ciclo_semana_id > ciclo_semana.id [ delete: no action, update: no action ]
}

Ref fk_ciclo_semana_composicion_tipo_sesion_id_tipo_sesion {
	ciclo_semana_composicion.tipo_sesion_id > tipo_sesion.id [ delete: no action, update: no action ]
}

Ref fk_sesion_plan_usuario_id_usuario {
	sesion_plan.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_sesion_plan_ciclo_semana_id_ciclo_semana {
	sesion_plan.ciclo_semana_id > ciclo_semana.id [ delete: no action, update: no action ]
}

Ref fk_sesion_plan_tipo_sesion_id_tipo_sesion {
	sesion_plan.tipo_sesion_id > tipo_sesion.id [ delete: no action, update: no action ]
}

Ref fk_bloque_plan_sesion_plan_id_sesion_plan {
	bloque_plan.sesion_plan_id > sesion_plan.id [ delete: no action, update: no action ]
}

Ref fk_bloque_plan_ejercicio_id_ejercicio {
	bloque_plan.ejercicio_id > ejercicio.id [ delete: no action, update: no action ]
}

Ref fk_sesion_usuario_id_usuario {
	sesion.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_sesion_sesion_plan_id_sesion_plan {
	sesion.sesion_plan_id - sesion_plan.id [ delete: no action, update: no action ]
}

Ref fk_sesion_tipo_sesion_id_tipo_sesion {
	sesion.tipo_sesion_id > tipo_sesion.id [ delete: no action, update: no action ]
}

Ref fk_bloque_sesion_id_sesion {
	bloque.sesion_id > sesion.id [ delete: cascade, update: no action ]
}

Ref fk_bloque_ejercicio_id_ejercicio {
	bloque.ejercicio_id > ejercicio.id [ delete: no action, update: no action ]
}

Ref fk_partido_sesion_id_sesion {
	partido.sesion_id - sesion.id [ delete: no action, update: no action ]
}

Ref fk_registro_sueno_usuario_id_usuario {
	registro_sueno.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_registro_bienestar_usuario_id_usuario {
	registro_bienestar.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_registro_hidratacion_usuario_id_usuario {
	registro_hidratacion.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_habito_registro_habito_id_habito {
	habito_registro.habito_id > habito.id [ delete: no action, update: no action ]
}

Ref fk_molestia_usuario_id_usuario {
	molestia.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_molestia_zona_id_zona_corporal {
	molestia.zona_id > zona_corporal.id [ delete: no action, update: no action ]
}

Ref fk_medida_corporal_usuario_id_usuario {
	medida_corporal.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_test_fisico_usuario_id_usuario {
	test_fisico.usuario_id > usuario.id [ delete: no action, update: no action ]
}

Ref fk_test_fisico_tipo_test_id_tipo_test {
	test_fisico.tipo_test_id > tipo_test.id [ delete: no action, update: no action ]
}

